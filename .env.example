# Postgres connection string (Neon via the Vercel Marketplace works out of the box).
# Leave empty to use a local PGlite database stored in .data/ (development only).
DATABASE_URL=

# Password for the web dashboard, at least 12 characters.
ADMIN_PASSWORD=change-me-to-something-long

# Optional: part of the key that signs the login cookie (defaults to ADMIN_PASSWORD; a random secret
# kept in the database is always mixed in). Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Optional: the site's address, so passkeys always belong to it (e.g. https://snippets.example.com).
JIG_ORIGIN=

# Time zone for dates shown in the dashboard.
JIG_TIMEZONE=Australia/Sydney

# Encrypts saved credentials. 32 random bytes in base64: openssl rand -base64 32
# Keep a copy somewhere safe: if it is lost, saved secrets cannot be recovered.
JIG_ENCRYPTION_KEY=

# Optional: turns on the AI helpers (rephrase a note, check a snippet for errors) using Google's
# Gemini API, which has a free tier. Get a key at https://aistudio.google.com/apikey
# Locked notes and credentials are never sent.
GEMINI_API_KEY=

# Optional: runs the AI helpers on OpenRouter instead (https://openrouter.ai/keys): open models like
# GLM and DeepSeek for fractions of a cent, sent only to hosts outside China that don't keep prompts.
# Needs a little credit on the account.
OPENROUTER_API_KEY=

# Optional: which to use when both keys are set (gemini or openrouter; default gemini).
JIG_AI_PROVIDER=

# Optional: the main model (default: gemini-flash-latest on Gemini, ~z-ai/glm-flash-latest on OpenRouter).
JIG_AI_MODEL=
